# 复制本文件为 application-local.yml 并填入本机真实凭证
# application-local.yml 已被 .gitignore 忽略，不会入库
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/easy_bpm?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false&rewriteBatchedStatements=true
    username: root
    password: 你的数据库密码
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      maximum-pool-size: 12
      minimum-idle: 2
      connection-timeout: 5000
